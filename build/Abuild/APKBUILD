# Maintainer: Ethan Leir <eleir@qnx.com>
pkgname=flex
pkgver=2.6.4
pkgrel=1
pkgdesc="A tool for generating fast lexical analyzers"
arch="all"
license="BSD-2-Clause"
url="https://github.com/westes/flex"
depends="m4 qnx-io-sock"
depends_dev="flex"
makedepends="$depends_dev bison help2man qnx-io-sock-dev qnx-libc++-dev"
subpackages="$pkgname-dev $pkgname-libs $pkgname-doc"
source="https://github.com/westes/flex/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz"

prepare() {
    default_prepare
    update_config_sub
}


build() {
    CC=gcc \
    CFLAGS="$CFLAGS -Wl,-lregex" ./configure \
        --build=$CBUILD \
        --host=$CHOST \
        --prefix=/usr \
	--mandir=/usr/share/man \
	--infodir=/usr/share/info \
	--disable-static \
	--enable-shared

    make
}

check() {
    make check
}

package() {
    make DESTDIR="$pkgdir" install
    ln -s flex "$pkgdir"/usr/bin/lex
}

sha512sums="
e9785f3d620a204b7d20222888917dc065c2036cae28667065bf7862dfa1b25235095a12fd04efdbd09bfd17d3452e6b9ef953a8c1137862ff671c97132a082e  flex-2.6.4.tar.gz
"
